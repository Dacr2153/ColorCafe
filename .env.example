# ---------- Variables de entorno CaféVision ----------
# Copia este archivo a .env y ajusta los valores

# PostgreSQL
POSTGRES_DB=cafevision
POSTGRES_USER=cafevision
POSTGRES_PASSWORD=cafevision_dev_password

# Redis
REDIS_PASSWORD=cafevision_dev_redis

# MinIO
MINIO_ROOT_USER=cafevision_minio
MINIO_ROOT_PASSWORD=cafevision_dev_minio_password_min_32_chars_x

# Ollama
OLLAMA_MODEL=mistral:7b-instruct

# App
LOG_LEVEL=debug
SKIP_MIGRATIONS=0

# Email — vacío usa LogSender (FinalStore pattern: no es simulación, escribe a logs reales)
RESEND_API_KEY=
EMAIL_FROM=noreply@cafevision.local
